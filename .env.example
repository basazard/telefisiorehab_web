APP_NAME=TeleFisioRehab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Servers (staging, pilot): LOG_CHANNEL=daily, LOG_DAILY_DAYS=14, LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telefisiorehab
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Servers (staging, pilot): SESSION_LIFETIME=60 (DRAFT), SESSION_SAME_SITE=lax. With an https APP_URL the cookie is secure automatically.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue worker on Hostinger: jobs and mail run synchronously.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. Local: "log" writes emails to storage/logs/laravel.log. Servers (staging, pilot): MAIL_MAILER=smtp with the Hostinger mailbox.
# Put credentials only in the server .env, never here. See README "Email setup".
# MAIL_SCHEME: leave empty. Laravel then uses SSL on port 465 and STARTTLS on port 587 (both open on smtp.hostinger.com).
# MAIL_USERNAME is the full mailbox address; MAIL_FROM_ADDRESS is the same address.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Staging only: every email goes to this one address instead of the real recipients. Never set it on the pilot site.
MAIL_ALWAYS_TO=

# Pilot (PRD 11). PILOT_MODE=true on the pilot site: noindex, pilot banner, go-live check.
PILOT_MODE=false
# open | clinic_code (a valid clinic code is needed to register) | closed (invitations only)
REGISTRATION_MODE=clinic_code
ALERT_EMAIL=
HEALTH_TOKEN=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# Backups (PRD 11 E5, scripts/backup-db.sh and scripts/restore-drill.sh). Absolute paths on servers.
BACKUP_DIR=
BACKUP_PASSPHRASE_FILE=
# An EMPTY scratch database for the restore drill, never the live one.
BACKUP_DRILL_DB_HOST=
BACKUP_DRILL_DB_DATABASE=
BACKUP_DRILL_DB_USERNAME=
BACKUP_DRILL_DB_PASSWORD=

# Clinical release gate (PRD 10). Leave unset: required when APP_ENV=production. Never false on a server real patients use.
# CLINICAL_SIGNOFF_REQUIRED=true
# Licensed instruments (prd/legal/instrument-licences.md). Unset = on. Set to false when a licence is refused.
# CLINICAL_ODI_ENABLED=true
# CLINICAL_SPADI_ENABLED=true
# CLINICAL_BORG_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
